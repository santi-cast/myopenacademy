# Configuración de esta academia (H10). Copia este fichero a .env (cp -n .env.example .env) y rellena lo que falte.
# .env no se guarda en Git. Todo tiene un valor por defecto pensado para usarla solo en este equipo, salvo la contraseña.

# --- Base de datos (PostgreSQL) ---
# Nombre de la base y su usuario. No los cambies después de crear la base: PostgreSQL se queda con los primeros.
DB_NAME=code_academy
DB_USERNAME=code_academy
# Obligatoria: una contraseña larga, sin comillas. No la compartas ni la pegues en ningún sitio.
DB_PASSWORD=
# Dónde está la base. Con Compose, el servicio «db»; en desarrollo, este equipo. El 5434 no choca con el 5433 del
# Code Academy original.
DB_HOST=127.0.0.1
DB_PORT=5434

# --- Aplicación ---
# Dirección y puerto en los que escucha la aplicación. 127.0.0.1: solo este equipo. Compose ya usa 0.0.0.0 dentro de
# su contenedor; quién puede entrar lo decide APP_BIND.
APP_ADDRESS=127.0.0.1
APP_PORT=8080
# Con Compose: en qué dirección de este equipo se publica la aplicación. 127.0.0.1, solo este equipo; 0.0.0.0, también
# la red de casa (ver la guía de instalación: sin HTTPS, las contraseñas viajan sin cifrar por la red).
APP_BIND=127.0.0.1
# La dirección con la que se entra a la academia, por ejemplo http://192.168.1.50:8080 o http://mi-equipo.local:8080.
PUBLIC_URL=http://127.0.0.1:8080
# La carpeta con los cursos instalados. En desarrollo, ../content desde backend/; Compose la monta en /content.
CONTENT_DIR=../content
